# ── AWS ──────────────────────────────────────
aws_region = "us-east-1"

# ── Project ───────────────────────────────────
project_name = "twolevel-autoscaling"
environment  = "dev"

# ── Networking (VPC) ──────────────────────────
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
database_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]

# ── EKS ──────────────────────────────────────
cluster_version         = "1.36"
node_instance_types     = ["t3.medium"]
node_group_min_size     = 1
node_group_max_size     = 3
node_group_desired_size = 2
eks_public_access_cidrs = ["203.0.113.10/32", "120.120.120.120/32"] # REPLACE with your current public IPv4/32 before plan/apply

# ── RDS ──────────────────────────────────────
postgres_engine_version  = "17.11"
mysql_engine_version     = "8.4.11"
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_backup_retention_days = 1
db_deletion_protection   = false # Disposable coursework environment only
db_create_final_snapshot = false # Export or snapshot data before destroy if needed

# ── Karpenter ─────────────────────────────────
karpenter_version   = "1.15.0"
karpenter_namespace = "karpenter"

# ── KEDA ──────────────────────────────────────
keda_version   = "2.21.0"
keda_namespace = "keda"
enable_cluster_addons = false # Set true for the second apply after EKS nodes are Ready
enable_keda_scaled_objects = false # Set true after retailstore and worker Deployments exist
keda_queue_length          = 10
keda_min_replica_count     = 0
keda_max_replica_count     = 10
keda_polling_interval      = 30
keda_cooldown_period       = 300

# ── Observability ─────────────────────────────
monitoring_namespace   = "monitoring"
enable_observability   = false # Turn on for Phase 4 after creating grafana-admin Secret
monitoring_chart_version = "92.7.0"
grafana_admin_secret_name = "grafana-admin"

# ── Cost alert ───────────────────────────────
budget_alert_email = null # Set to an email address to receive the 80% monthly cost alert
monthly_budget_usd = 100

# ── SQS ───────────────────────────────────────
sqs_queue_names        = ["cart-queue", "orders-queue", "checkout-queue"]
sqs_visibility_timeout = 60
sqs_message_retention  = 345600

# ── ECR ───────────────────────────────────────
ecr_repo_names = ["catalog", "cart", "orders", "checkout", "recommendations", "ui"]
