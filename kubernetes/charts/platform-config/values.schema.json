{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kedaAuthentication": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "monitoring": {
      "type": "boolean"
    },
    "nodePool": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "instanceTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "capacityTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "on-demand",
              "spot"
            ]
          }
        },
        "instanceCategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "consolidateAfter": {
          "type": "string",
          "pattern": "^([0-9]+[smh]|Never)$"
        }
      }
    }
  }
}
