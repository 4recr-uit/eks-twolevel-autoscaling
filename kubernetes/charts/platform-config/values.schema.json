{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "monitoring": {
      "type": "boolean"
    },
    "nodePool": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "default"
          ]
        },
        "capacityTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "on-demand",
              "spot"
            ]
          }
        },
        "instanceCategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "consolidateAfter": {
          "type": "string",
          "pattern": "^([0-9]+[smh]|Never)$"
        }
      }
    }
  }
}
