{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cart": {"type": "boolean"},
        "orders": {"type": "boolean"},
        "checkout": {"type": "boolean"}
      }
    },
    "scaling": {
      "type": "object",
      "required": [
        "min",
        "max",
        "queueLength",
        "pollingInterval",
        "cooldownPeriod"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "queueLength": {
          "type": "integer",
          "minimum": 1
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
